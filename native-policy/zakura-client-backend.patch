+    /// Applies the wallet's spending-state retention policy before storing a scan.
+    /// Viewing history and nullifiers remain available; only per-note witness marks
+    /// are withheld. Shared block checkpoints are preserved.
+    pub fn retain_spending_state(&mut self, retain: impl Fn(&AccountId) -> bool) {
+        fn unmark<H, N>(bundle: &mut ScannedBundles<H, N>, position: incrementalmerkletree::Position) {
+            let start = u64::from(bundle.final_tree_size) - bundle.commitments.len() as u64;
+            let index = usize::try_from(u64::from(position) - start).expect("scanned position");
+            let retention = &mut bundle.commitments[index].1;
+            *retention = match *retention {
+                Retention::Checkpoint { id, .. } => Retention::Checkpoint {
+                    id, marking: incrementalmerkletree::Marking::None,
+                },
+                _ => Retention::Ephemeral,
+            };
+        }
+        for tx in &self.transactions {
+            for output in tx.sapling_outputs() {
+                if !retain(output.account_id()) {
+                    unmark(&mut self.sapling, output.note_commitment_tree_position());
+                }
+            }
+            #[cfg(feature = "orchard")]
+            for output in tx.orchard_outputs() {
+                if !retain(output.account_id()) {
+                    unmark(&mut self.orchard, output.note_commitment_tree_position());
+                }
+            }
+            #[cfg(feature = "orchard")]
+            for output in tx.ironwood_outputs() {
+                if !retain(output.account_id()) {
+                    unmark(&mut self.ironwood, output.note_commitment_tree_position());
+                }
+            }
         }
     }
 
