+/// Removes legacy per-note spend support for native view-only accounts.
+///
+/// The caller must commit this transaction together with its policy version marker,
+/// before exposing the wallet. Shared checkpoints, viewing authority and note history
+/// are retained. This is logical pruning, not physical erasure.
+pub fn migrate_view_only_spend_support(tx: &rusqlite::Transaction<'_>) -> Result<(), SqliteClientError> {
+    for pool in [ShieldedPool::Sapling,
+        #[cfg(feature = "orchard")] ShieldedPool::Orchard,
+        #[cfg(feature = "orchard")] ShieldedPool::Ironwood,
+    ] {
+        let prefix = match pool {
+            ShieldedPool::Sapling => "sapling",
+            ShieldedPool::Orchard => "orchard",
+            ShieldedPool::Ironwood => "ironwood",
+        };
+        let mut stmt = tx.prepare(&format!(
+            "SELECT DISTINCT rn.commitment_tree_position FROM {prefix}_received_notes rn
+             JOIN accounts a ON a.id = rn.account_id
+             WHERE a.has_spend_key = 0 AND rn.commitment_tree_position IS NOT NULL"
+        ))?;
+        let positions = stmt.query_map([], |row| row.get::<_, u64>(0))?
+            .collect::<Result<Vec<_>, _>>()?;
+        for position in positions {
+            // None clears the mark immediately, rather than deferring removal to
+            // checkpoint expiry (which could otherwise restore it after rewind).
+            match pool {
+                ShieldedPool::Sapling => { sapling_tree(tx)?.remove_mark(position.into(), None)?; }
+                #[cfg(feature = "orchard")]
+                ShieldedPool::Orchard => { orchard_tree(tx)?.remove_mark(position.into(), None)?; }
+                #[cfg(feature = "orchard")]
+                ShieldedPool::Ironwood => { ironwood_tree(tx)?.remove_mark(position.into(), None)?; }
+                #[cfg(not(feature = "orchard"))]
+                _ => {}
+            }
+            tx.execute(&format!(
+                "DELETE FROM {prefix}_tree_checkpoint_marks_removed WHERE mark_removed_position = ?1"
+            ), [position])?;
+        }
+        tx.execute(&format!(
+            "UPDATE {prefix}_received_notes SET witness_stabilized = 0
+             WHERE witness_stabilized != 0 AND account_id IN (SELECT id FROM accounts WHERE has_spend_key = 0)"
+        ), [])?;
+    }
+    Ok(())
 }

