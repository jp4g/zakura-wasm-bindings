+            block.retain_spending_state(|id| spending_accounts.iter().any(|(candidate, account)| {
+                candidate == id && account.as_ref().is_some_and(|a| {
+                    a.purpose() != AccountPurpose::ViewOnly
+                })
+            }));
+        }
